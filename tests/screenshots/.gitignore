# screenshots are made fresh by every test run (about 36 MB); keep them on your computer only
*
!.gitignore
# except the positioning audit sheets, which are committed on purpose
!positions/
!positions/*.png
!positions/*.txt
# and the cat in every spot and frame (tests/cat_shots.py)
!cat/
!cat/*.png
# and the seedling pot shots
!seedlings/
!seedlings/*.png
# and the calm-down pictures (tests/calm_shots.py)
!calm/
!calm/*.png
# and the cat walking off when he has had enough (tests/cat_huff.py)
!huff/
!huff/*.png
# and the debug drawer on a phone (tests/debug_test.py)
!debug/
!debug/*.png
# and the caption bubble (tests/caption_test.py)
!captions/
!captions/*.png
